{
  "name": "itmosoft/laravel-vendor-payouts",
  "description": "Vendor earnings ledger and payout lifecycle management for Laravel marketplace applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "ItmoSoft\\VendorPayouts\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ItmoSoft\\VendorPayouts\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ItmoSoft\\VendorPayouts\\VendorPayoutsServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-text"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "itmosoft/laravel-vendors": "Required when using the default ItmoSoft vendor model."
  }
}
